# Supabase - required for stock, ingredients, and polish recipe data
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for server-side admin create/update/delete actions on Vercel
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify order webhooks (server-only; never expose as NEXT_PUBLIC_*)
# App/client secret used to verify X-Shopify-Hmac-Sha256 on raw webhook bodies
SHOPIFY_CLIENT_SECRET=your-shopify-app-client-secret
# When set, reject webhooks whose X-Shopify-Shop-Domain does not match
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com

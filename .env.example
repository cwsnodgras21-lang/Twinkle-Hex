# Supabase - required for stock, ingredients, and polish recipe data
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for server-side admin create/update/delete actions on Vercel
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify → n8n ingest (server-only; never expose as NEXT_PUBLIC_*)
TWINKLE_N8N_INGEST_SECRET=generate-a-long-random-string
# Optional default shop domain when n8n payload omits shopDomain
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
